{
  "manifest_version": 3,
  "name": "Shop Twin",
  "version": "0.1.0",
  "description": "See your shop in 3D. Shop Twin mirrors the repair orders open in your Tekmetric tab onto a live floor plan of your bays and lot.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open Shop Twin",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage"],
  "host_permissions": ["https://*.tekmetric.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.tekmetric.com/*"],
      "js": ["capture/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.tekmetric.com/*"],
      "js": ["capture/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
