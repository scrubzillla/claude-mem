# Copy to .env and fill in. Never commit .env.

# mock | sandbox | production
TEKMETRIC_ENV=sandbox

# From Tekmetric after the API application is approved (Basic auth for the token endpoint).
TEKMETRIC_CLIENT_ID=
TEKMETRIC_CLIENT_SECRET=

# Optional: which shop to show when the credentials cover more than one. Defaults to the first shop.
TEKMETRIC_SHOP_ID=

# Send changes back to Tekmetric (assign technician). Default: on for sandbox, off for production.
TEKMETRIC_WRITES=

# How often to pull open repair orders, in seconds (production limit is 600 requests/minute).
POLL_SECONDS=30

# Who can open the twin. Required whenever HOST is not localhost.
SHOP_TWIN_PASSCODE=
HOST=127.0.0.1
PORT=8787
